# Python
__pycache__/
*.py[cod]

# Evaluation outputs.
#
# These are regenerated by the pipeline and are megabytes per benchmark:
#   python run_qwen_eval2.py ... / run_cgr.py ... -> rebuttal/
#   python score_parallel.py ...                   -> rebuttal/scores/
# Keep them local; the scripts and the table builder are what gets committed.
rebuttal/haloquest/
rebuttal/mmstar/
rebuttal/mmbench/
rebuttal/scores/
rebuttal/logs/
rebuttal/_superseded/
rebuttal/*_deepseek_eval.json

# ICoT one-shot demonstration: demo.json and the crops are small and are the
# input to the method, the two full-size images are rebuilt by
# build_icot_demo.py.
qwen_eval2/demos/*/image.png
qwen_eval2/demos/*/preview.png

# Result tables
rebuttal/baseline_table*.md
